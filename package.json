{
  "name": "fine-video-as-code",
  "version": "0.1.0",
  "description": "Open-source Video-as-Code pipeline. Turn a short topic into a polished explainer video: web form + JSON input + 3-step backend workflow (Scripting + Edge-TTS + Playwright/ffmpeg-static) + MP4 file. Three built-in templates (Tech Explainer, Promo, Tutorial).",
  "main": "backend/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "setup": "node scripts/check-deps.js",
    "render-sample": "node scripts/render-sample.js",
    "test": "node --test backend/tests/*.test.js",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "video",
    "video-as-code",
    "playwright",
    "ffmpeg",
    "edge-tts",
    "tts",
    "automation",
    "ai",
    "explainer"
  ],
  "author": "Huỳnh Phương Bảo An <hpbaoan@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hpbaoan-source/fine-video-as-code.git"
  },
  "bugs": {
    "url": "https://github.com/hpbaoan-source/fine-video-as-code/issues"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.0",
    "ffmpeg-static": "^5.3.0",
    "nanoid": "^5.0.7",
    "playwright": "^1.64.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.2.0"
  }
}

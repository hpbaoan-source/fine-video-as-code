# Auto-detect text files, force LF line endings
* text=auto eol=lf

# Source code
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.py        text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.mp4       binary
*.mp3       binary
*.wav       binary
*.zip       binary
*.gz        binary
*.glb       binary
*.gltf      binary

# Lockfiles (allow LF even on Windows)
package-lock.json text eol=lf
yarn.lock       text eol=lf
pnpm-lock.yaml  text eol=lf

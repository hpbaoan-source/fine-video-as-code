# ──────────────────────────────────────────────────────────────
# Node / npm
# ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ──────────────────────────────────────────────────────────────
# Playwright runtime artifacts
# ──────────────────────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/
output/

# ──────────────────────────────────────────────────────────────
# Sample video files ARE committed (~2 MB total).
# Re-renders drop them in samples/<name>/video.mp4 and they
# get checked in via the next `git add samples/`.
# User-generated output (in tmp/jobs/<jobId>/) is NOT committed
# (covered by the `tmp/` rule below).
# ──────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────
# Environment & secrets — NEVER commit
# ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
secrets/
github_access_token.txt
docs/github-support-ticket-dangling-objects.md
fine-video-as-code.zip

*-token.txt
*_token.txt

# ──────────────────────────────────────────────────────────────
# Editor / OS junk
# ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
*.log
logs/

# ──────────────────────────────────────────────────────────────
# Test artifacts
# ──────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ──────────────────────────────────────────────────────────────
# OS-level temp
# ──────────────────────────────────────────────────────────────
tmp/
temp/
.tmp/

# Playwright sometimes creates a sibling folder at the project root
# with a whitespace-only name (e.g. "D:\Projects\video_as_code\ 0")
# when launched from a path that contains a trailing space. It's
# the Chromium browser cache and is regenerated by `npx playwright
# install chromium`. Never commit it.
 0
 0/

# ──────────────────────────────────────────────────────────────
# Generated / cache
# ──────────────────────────────────────────────────────────────
.cache/
.cache-*/
.eslintcache
.parcel-cache/

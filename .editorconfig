# ──────────────────────────────────────────────────────────────
# EditorConfig — https://editorconfig.org
# One shared set of whitespace rules for every editor.
# ──────────────────────────────────────────────────────────────
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{py,sh,ps1}]
indent_size = 4
